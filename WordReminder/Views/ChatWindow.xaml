<controls:WindowBase x:Class="WordReminder.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WordReminder.Converters"
        xmlns:controls="clr-namespace:WordReminder.Controls"
        TitleText="对话"
        Width="800"
        Height="550"
        CanResize="True"
        MinWidth="700"
        MinHeight="450">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:CollectionEmptyToVisibilityConverter x:Key="CollectionEmptyToVisibilityConverter"/>

        <!-- 消息气泡样式 -->
        <Style x:Key="MessageBubbleStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MaxWidth" Value="500"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：助手信息 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding AssistantIcon}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AssistantName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding ConversationTitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧：模型信息 + 切换面板按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModelInfo}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <Button Content="☰" Command="{Binding TogglePanelCommand}" Width="32" Height="28" FontSize="14" Padding="0" Style="{StaticResource SecondaryButtonStyle}" ToolTip="切换对话历史"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 中间内容区域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- 左侧对话历史面板（可折叠） -->
                    <ColumnDefinition Width="200" x:Name="LeftPanelColumn"/>
                    <!-- 右侧聊天区域 -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：对话历史列表 -->
                <Border Grid.Column="0" BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceAltBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 对话历史标题 + 新对话按钮 -->
                        <Border Grid.Row="0" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="对话历史" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="新对话" Command="{Binding NewConversationCommand}" Width="70" Height="26" FontSize="11" Padding="0" Style="{StaticResource PrimaryButtonStyle}"/>
                            </Grid>
                        </Border>

                        <!-- 对话列表 + 空状态 -->
                        <Grid Grid.Row="1">
                            <!-- 对话列表 -->
                            <ListBox ItemsSource="{Binding Conversations}"
                                     SelectedItem="{Binding SelectedConversation}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionMode="Single"
                                     Visibility="{Binding Conversations, Converter={StaticResource CollectionEmptyToVisibilityConverter}, ConverterParameter=Invert}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}"
                                                            Margin="{TemplateBinding Margin}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource PrimaryBgBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E8F0FE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7"/>
                                                <TextBlock Grid.Column="1" Text="{Binding MessageCount, StringFormat={}({0})}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7" Margin="4,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 空状态提示 -->
                            <TextBlock Text="暂无对话历史" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Conversations, Converter={StaticResource CollectionEmptyToVisibilityConverter}}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右侧：聊天区域 -->
                <Border Grid.Column="1" Padding="16" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 消息列表 -->
                        <ScrollViewer Grid.Row="0" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 使用 Grid 布局，用户消息在右侧，AI 消息在左侧 -->
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- AI 消息（左对齐，Markdown 渲染） -->
                                                <Border Grid.Column="0"
                                                        Background="#F0F2F5"
                                                        CornerRadius="12,12,12,2"
                                                        Padding="4"
                                                        MaxWidth="500"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding IsAssistant, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <RichTextBox IsReadOnly="True"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 FontSize="13"
                                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                                 Padding="8,4"
                                                                 MaxWidth="492"
                                                                 converters:MarkdownHelper.Markdown="{Binding Content, Mode=OneWay}"
                                                                 VerticalScrollBarVisibility="Disabled"
                                                                 HorizontalScrollBarVisibility="Disabled"/>
                                                </Border>

                                                <!-- 用户消息（右对齐） -->
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="12,12,2,12"
                                                        Padding="12,8"
                                                        MaxWidth="450"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 空状态提示 -->
                                <TextBlock Text="开始新对话，发送消息给助手" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- 输入区域 -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 输入框 -->
                                    <TextBox Grid.Column="0"
                                             x:Name="InputTextBox"
                                             Height="36"
                                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Padding="12,0"
                                             FontSize="13"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             PreviewKeyDown="InputTextBox_PreviewKeyDown"/>

                                    <!-- 发送/取消按钮 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="取消" Command="{Binding CancelSendCommand}" Width="60" Height="36" FontSize="12" Margin="0,0,8,0"
                                                Visibility="{Binding IsSending, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource SecondaryButtonStyle}"/>
                                        <Button Content="发送" Command="{Binding SendMessageCommand}" Width="70" Height="36" FontSize="12"
                                                IsEnabled="{Binding IsSending, Converter={StaticResource InverseBooleanConverter}}" Style="{StaticResource PrimaryButtonStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 提示文本 -->
                                <TextBlock Text="Enter 发送 · Esc 取消" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部状态栏（可选，用于显示提示信息） -->
            <Border Grid.Row="2" Padding="12,6" BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SurfaceAltBrush}" Visibility="Collapsed">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </Grid>
    </Border>

</controls:WindowBase>
