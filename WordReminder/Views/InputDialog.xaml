<controls:WindowBase x:Class="WordReminder.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WordReminder.Controls"
        TitleText="输入"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Height="32" FontSize="13" Margin="0,0,0,15"/>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,0,0,5" Visibility="Collapsed"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" IsDefault="True" Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="取消" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</controls:WindowBase>
