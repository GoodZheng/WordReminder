<controls:WindowBase x:Class="WordReminder.Views.AssistantListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WordReminder.Controls"
        xmlns:converters="clr-namespace:WordReminder.Converters"
        xmlns:viewmodels="clr-namespace:WordReminder.ViewModels"
        TitleText="我的助手"
        Width="700"
        Height="500"
        CanResize="True"
        MinWidth="600"
        MinHeight="400">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏区域 -->
            <Border Grid.Row="0" BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="0,0,0,1" Padding="20,16" Background="{StaticResource SurfaceAltBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="我的助手" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="新建助手"
                            Width="80"
                            Height="32"
                            Command="{Binding NewAssistantCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Border>

            <!-- 主内容区域 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧助手列表 -->
                <Border Grid.Column="0" BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceAltBrush}">
                    <ListBox ItemsSource="{Binding Assistants}"
                             SelectedItem="{Binding SelectedAssistant}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBgBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E8F0FE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:AssistantListViewModel+AssistantItemViewModel}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="24" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="{Binding ConversationCountText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="34,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 右侧助手详情 -->
                <Border Grid.Column="1" Padding="20" Background="White">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Visibility="{Binding SelectedAssistant, Converter={StaticResource NullToVisibilityConverter}}">
                            <!-- 助手基本信息 -->
                            <StackPanel Margin="0,0,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding SelectedAssistant.Icon}" FontSize="48" Margin="0,0,16,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedAssistant.Name}" FontWeight="Bold" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding SelectedAssistantDetail}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- 系统提示词 -->
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="系统提示词" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Background="{StaticResource SurfaceAltBrush}">
                                    <TextBlock Text="{Binding SelectedAssistant.Assistant.SystemPrompt}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               LineHeight="20"/>
                                </Border>
                            </StackPanel>

                            <!-- 参数信息 -->
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="参数设置" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 温度 -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="温度" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedAssistant.Assistant.Temperature, StringFormat={}{0:F1}}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- 最大 Token -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                        <TextBlock Text="最大 Token" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedAssistant.Assistant.MaxTokens}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- 对话数量 -->
                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <TextBlock Text="对话数量" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedConversationCount}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- 最后活跃 -->
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="最后活跃" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding SelectedLastActive}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- 底部按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="删除"
                                        Width="80"
                                        Height="32"
                                        Command="{Binding DeleteAssistantCommand}"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource DangerButtonStyle}"/>

                                <Button Content="编辑"
                                        Width="80"
                                        Height="32"
                                        Command="{Binding EditAssistantCommand}"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                <Button Content="开始对话"
                                        Width="80"
                                        Height="32"
                                        Command="{Binding StartChatCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>

</controls:WindowBase>
