<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary colors -->
    <Color x:Key="PrimaryColor">#7B68EE</Color>
    <Color x:Key="PrimaryDarkColor">#5B4FCF</Color>
    <Color x:Key="PrimaryLightColor">#9B8DF5</Color>
    <Color x:Key="PrimaryBgColor">#EDE9FE</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryBgBrush" Color="{StaticResource PrimaryBgColor}"/>

    <!-- Surface colors -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F5F3FF</Color>
    <Color x:Key="SurfaceHoverColor">#EDE9FE</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>

    <!-- Text colors -->
    <Color x:Key="TextPrimaryColor">#1E1B4B</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="TextDisabledColor">#9CA3AF</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <!-- Semantic colors -->
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerHoverColor">#B91C1C</Color>
    <Color x:Key="SuccessColor">#16A34A</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <!-- Border colors -->
    <Color x:Key="BorderColor">#D1D5DB</Color>
    <Color x:Key="BorderFocusColor">#7B68EE</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <!-- Other brushes -->
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#C4B5FD"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#33000000"/>

</ResourceDictionary>
