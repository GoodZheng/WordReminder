<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false"
	      internalLogFile="${specialfolder:folder=LocalApplicationData}/WordReminder/logs/nlog-internal.log"
	      internalLogLevel="Warn">

  <targets>
    <!-- 文件日志：按日期分割，保留最近 7 天 -->
    <target name="logfile"
            xsi:type="File"
            fileName="${specialfolder:folder=LocalApplicationData}/WordReminder/logs/${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception:format=tostring}"
            encoding="utf-8"
            maxArchiveFiles="7"
            archiveEvery="Day"
            archiveFileName="${specialfolder:folder=LocalApplicationData}/WordReminder/logs/archive.{#}.log"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            enableArchiveFileCompression="false"
            keepFileOpen="false"
            concurrentWrites="true" />

    <!-- 控制台输出：仅 Debug 构建时使用 -->
    <target name="logconsole"
            xsi:type="Console"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- 应用日志：Info 及以上写入文件 -->
    <logger name="WordReminder.*" minlevel="Info" writeTo="logfile" final="true" />

    <!-- AI/Debug 相关：Trace 级别写入文件 -->
    <logger name="WordReminder.Services.AI*" minlevel="Trace" writeTo="logfile" final="true" />
    <logger name="WordReminder.Services.BingDictionary*" minlevel="Trace" writeTo="logfile" final="true" />

    <!-- 框架日志：只记录 Warn 及以上 -->
    <logger name="Microsoft.*" minlevel="Warn" writeTo="logfile" final="true" />
    <logger name="System.*" minlevel="Warn" writeTo="logfile" final="true" />

    <!-- 兜底：所有未被上面规则匹配的日志记录 Info 到文件 -->
    <logger name="*" minlevel="Info" writeTo="logfile" />
  </rules>
</nlog>
